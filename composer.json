{
    "name": "hoceineel/filament-whatsapp-agent",
    "description": "A WhatsApp AI agent for Filament apps: Evolution and Cloud API channels, a shared inbox, voice notes, personal-number screening and pluggable business tools.",
    "keywords": [
        "hoceineel",
        "laravel",
        "filament",
        "whatsapp",
        "ai",
        "agent",
        "evolution-api",
        "chatbot"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Hoceine El Idrissi",
            "email": "contact@hoceine.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "laravel/ai": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "HoceineEl\\WhatsAppAgent\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "HoceineEl\\WhatsAppAgent\\WhatsAppAgentServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "HoceineEl\\WhatsAppAgent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    }
}
